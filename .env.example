# ============================================
# LuxeJewels / TJ E-commerce - Environment
# ============================================

# ---------- Database (PostgreSQL) ----------
# Free options: Neon, Supabase, Railway
# Local example: postgresql://postgres:password@localhost:5432/luxejewels
DATABASE_URL="postgresql://user:password@host:5432/database?sslmode=require"

# ---------- Authentication ----------
# Any long random string (min 32 characters)
JWT_SECRET="change-this-to-a-long-random-secret-key-min-32-chars"

# ---------- Razorpay (Payments) ----------
# Get from https://dashboard.razorpay.com/app/keys
# Use Test Mode keys while developing
RAZORPAY_KEY_ID="rzp_test_xxxxxxxxxxxxxxxx"
RAZORPAY_KEY_SECRET="xxxxxxxxxxxxxxxxxxxxxxxx"

# ---------- Cloudinary (Product Images) ----------
# Get from https://cloudinary.com/console
CLOUDINARY_CLOUD_NAME="your-cloud-name"
CLOUDINARY_API_KEY="123456789012345"
CLOUDINARY_API_SECRET="xxxxxxxxxxxxxxxxxxxxxxxx"

# ---------- App ----------
NEXT_PUBLIC_APP_URL="http://localhost:3000"
NODE_ENV="development"
